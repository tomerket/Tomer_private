# ImageKit
NEXT_PUBLIC_IMAGEKIT_ID=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<your-id>
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=

# Player analytics is an ImageKit Enterprise feature; keep false on the free plan
NEXT_PUBLIC_PLAYER_ANALYTICS=false

# Supabase (publishable key; no service-role key is used by this app)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Site URL used in magic-link redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Lets local scripts expire the catalog cache (POST /api/revalidate)
REVALIDATE_SECRET=
